[
  {
    "corsRuleName": "temp-file-drop-production",
    "allowedOrigins": [
      "https://temp-file-drop.pages.dev"
    ],
    "allowedHeaders": [
      "*"
    ],
    "allowedOperations": [
      "s3_put_object",
      "s3_get_object",
      "s3_head_object"
    ],
    "exposeHeaders": [
      "ETag"
    ],
    "maxAgeSeconds": 3600
  }
]